# ── THE FLASH — environment ──────────────────────────────────────────────
# Copy to .env and fill in. The server reads ./.env and ./server/.env.

# Session signing secret (REQUIRED in production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me-please-generate-a-long-random-string

# Bootstrap administrator account (created on first run only; hashed with bcrypt,
# never displayed in the UI). Change it later with:
#   node server/set-admin.js <email> <new-password> [name]
ADMIN_EMAIL=admin@theflash.app
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=The Flash Admin

# Artwork source. 'photos' (default) shows real photography for posters, backdrops
# and covers and falls back to generated art whenever an image cannot be loaded.
# 'generated' keeps everything offline using drawn artwork only.
IMAGE_SOURCE=photos

# TMDB (optional) — metadata import only; attribution required by the TMDB terms
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=en-US

# Session cookie. Secure cookies are only sent over HTTPS, so production turns this
# on by itself. Leave blank unless production is served over plain HTTP (a local
# smoke test): set it to false there, or the browser drops the cookie and sign-in
# silently fails.
COOKIE_SECURE=

# ── Email verification ───────────────────────────────────────────────────
# An account cannot be used until its address is confirmed. Set this to false
# only for a local demo or a test run — everything else assumes it is on.
REQUIRE_EMAIL_VERIFICATION=true

# Ask DNS whether a sign-up domain can receive mail at all before creating the
# account. Turn it off on an air-gapped host: an unreachable resolver is already
# treated as "unknown" and allowed through, so this only saves the wait.
EMAIL_MX_CHECK=true

# Public origin used to build the confirmation link inside the email. Defaults to
# http://localhost:<PORT>.
APP_URL=

# ── Outbound mail ────────────────────────────────────────────────────────
# SMTP_HOST unset ⇒ the "log" transport: messages are appended to
# <DATA_DIR>/mail-outbox.log and the confirmation link is also returned to the
# browser in development, so sign-up works with no mail server. Set SMTP_HOST to
# actually deliver. MAIL_TRANSPORT=log forces the log transport explicitly.
SMTP_HOST=
SMTP_PORT=587
# Blank = decide from the port (465 implies implicit TLS; 587/25 upgrade via
# STARTTLS). Set true/false to override.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=THE FLASH <no-reply@theflash.app>

# Where theflash.db lives, relative to the project root
DATA_DIR=data

# Ports
PORT=3001
VITE_PORT=5173
